{
  "name": "oqy-curriculum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:a11y": "node scripts/accessibility.mjs",
    "test:package": "node --test scripts/package.check.mjs",
    "test:strict": "node scripts/audit-browser.mjs",
    "evidence": "node scripts/generate-evidence.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
